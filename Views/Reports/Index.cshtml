    // ---------- Profit & Loss calendar ----------
    var pnlRows = [];  // last-loaded rows

    function fmtInr(n) {
        var sign = n < 0 ? '-' : '';
        return sign + '₹' + Math.abs(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function fmtDate(d) {
        var dd = String(d.getDate()).padStart(2,'0');
        var mm = String(d.getMonth()+1).padStart(2,'0');
        return d.getFullYear() + '-' + mm + '-' + dd;
    }
    function fmtDisplay(d) {
        var mo = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        return d.getDate() + ' ' + mo[d.getMonth()] + ' ' + d.getFullYear();
    }
    function computeRange(kind) {
        var to = new Date();
        var from = new Date();
        if (kind === 'week') from.setDate(to.getDate() - 6);
        else if (kind === '15d') from.setDate(to.getDate() - 14);
        else if (kind === 'month') from.setMonth(to.getMonth() - 1);
        else if (kind === '3m') from.setMonth(to.getMonth() - 3);
        else if (kind === 'year') from.setFullYear(to.getFullYear() - 1);
        return { from: from, to: to };
    }

    function loadPnl(from, to) {
        $('#pnlRangeText').text(fmtDisplay(from) + ' - ' + fmtDisplay(to));
        $.ajax({
            url: '/Home/GetPnlCalendar',
            type: 'GET',
            dataType: 'json',
            data: { fromDate: fmtDate(from), toDate: fmtDate(to) },
            success: function (res) {
                if (!res || !res.ok) { pnlRows = []; renderPnl(from, to); return; }
                pnlRows = res.rows || [];
                renderPnl(from, to);
            },
            error: function () { pnlRows = []; renderPnl(from, to); }
        });
    }

    function renderPnl(from, to) {
        // aggregate by day
        var byDay = {};
        var realized = 0;
        for (var i = 0; i < pnlRows.length; i++) {
            var r = pnlRows[i];
            var pl = parseFloat(r.netProfit) || 0;
            realized += pl;
            byDay[r.date] = (byDay[r.date] || 0) + pl;
        }
        var charges = 0; // placeholder — no per-trade charge data yet
        var net = realized - charges;

        $('#pnlRealized').text(fmtInr(realized)).css('color', realized >= 0 ? '#2d9d5f' : '#c62828');
        $('#pnlCharges').text(fmtInr(charges));
        $('#pnlNet').text(fmtInr(net)).css('color', net >= 0 ? '#2d9d5f' : '#c62828');

        // build month buckets between from..to
        var months = [];
        var cur = new Date(from.getFullYear(), from.getMonth(), 1);
        var end = new Date(to.getFullYear(), to.getMonth(), 1);
        while (cur <= end) {
            months.push({ y: cur.getFullYear(), m: cur.getMonth() });
            cur.setMonth(cur.getMonth() + 1);
        }

        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var $cal = $('#pnlCalendar').empty();

        for (var j = 0; j < months.length; j++) {
            var mo = months[j];
            var daysInMonth = new Date(mo.y, mo.m + 1, 0).getDate();
            var monthTotal = 0;
            var grid = '';
            for (var d = 1; d <= daysInMonth; d++) {
                // Skip Saturday (6) and Sunday (0) — Indian equity market is closed.
                var dow = new Date(mo.y, mo.m, d).getDay();
                if (dow === 0 || dow === 6) continue;

                var key = mo.y + '-' + String(mo.m + 1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
                var v = byDay[key] || 0;
                monthTotal += v;
                var cls = 'pnl-day';
                if (v > 0) {
                    var av = Math.abs(v);
                    if (av > 5000) cls += ' profit-lg';
                    else if (av > 1000) cls += ' profit-md';
                    else cls += ' profit-sm';
                } else if (v < 0) {
                    var av2 = Math.abs(v);
                    if (av2 > 5000) cls += ' loss-lg';
                    else if (av2 > 1000) cls += ' loss-md';
                    else cls += ' loss-sm';
                }
                grid += '<div class="' + cls + '" title="' + key + ': ' + fmtInr(v) + '"></div>';
            }
            var totalCls = monthTotal >= 0 ? 'profit' : 'loss';
            var totalText = monthTotal === 0 ? '' : fmtInr(monthTotal);
            var label = monthNames[mo.m] + ' ' + String(mo.y).slice(-2);
            $cal.append(
                '<div class="pnl-month">' +
                    '<div class="pnl-month-label">' + label + '</div>' +
                    '<div class="pnl-month-grid">' + grid + '</div>' +
                    '<div class="pnl-month-total ' + totalCls + '">' + totalText + '</div>' +
                '</div>'
            );
        }
    }

    function downloadPnlCsv() {
        if (!pnlRows.length) { alert('No data to download for the current range.'); return; }
        var lines = ['Date,Name,NetProfit,Dividend'];
        for (var i = 0; i < pnlRows.length; i++) {
            var r = pnlRows[i];
            lines.push([r.date, '"' + (r.name || '').replace(/"/g,'""') + '"', r.netProfit, r.dividend].join(','));
        }
        var blob = new Blob([lines.join('\n')], { type: 'text/csv' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = 'pl_statement.csv';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }

    $(document).ready(function () {
        $('.pnl-chip').click(function () {
            $('.pnl-chip').removeClass('active');
            $(this).addClass('active');
            var kind = $(this).data('range');
            if (kind === 'custom') {
                $('#pnlCustomFrom, #pnlCustomTo').show();
                $('#pnlCustomFrom, #pnlCustomTo').datepicker({ dateFormat: 'mm/dd/yy' });
                return;
            }
            $('#pnlCustomFrom, #pnlCustomTo').hide();
            var r = computeRange(kind);
            loadPnl(r.from, r.to);
        });
        $('#pnlCustomFrom, #pnlCustomTo').change(function () {
            var f = $('#pnlCustomFrom').val(), t = $('#pnlCustomTo').val();
            if (f && t) loadPnl(new Date(f), new Date(t));
        });
        // initial load: Year
        var r0 = computeRange('year');
        loadPnl(r0.from, r0.to);
    });
