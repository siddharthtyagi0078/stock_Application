    function CalculateprofitData(jsonObj) {

         min_value = 0;
         max_value = 0;
        var overallgain = 0;
        for (i = 0; i < jsonObj.Stocklist.length; i++) {

            overallgain += parseFloat(jsonObj.Stocklist[i].netProfit)+(parseFloat(jsonObj.Stocklist[i].dividend));
           console.log(jsonObj.Stocklist[i].dividend);
            if (jsonObj.Stocklist[i].netProfit > max_value) {
                max_value = jsonObj.Stocklist[i].netProfit;
              //  max_comp = jsonObj[i].Company_name;
            }
            if (jsonObj.Stocklist[i].netProfit < min_value) {
                min_value = jsonObj.Stocklist[i].netProfit;
               // min_comp = jsonObj[i].Company_name;
            }
        }


        if (overallgain > 0) {
            $('#dvtotalprofit').attr("style", "color: green");
        }
        else {
            $('#dvtotalprofit').attr("style", "color: red");

        }
        $('#dvtotalprofit').html('Total :- ₹' + overallgain.toLocaleString('en-IN') + ' (' + parseFloat(jsonObj.Stocklist[0].netProfitPercent) + '%)' + " in " + jsonObj.Stocklist.length + " Trades");
        $('#dvtotalprofitsummary').html(jsonObj.Summary);

    }

