<style>
    .tabs {
     
        width: 100%;
        text-align: left;
    }

   

    .tab-nav-wrapper {
        width: 100%;
        overflow-x: auto;
        position: relative !important;
        z-index: 999 !important;
        top: 3px;
    }

    .tabs ul {
        display: block;
        /*width: max-content;*/
        overflow-y: hidden;
        margin: 0px;
        padding-inline-start: 5px;
    }

        .tabs ul li {
            display: inline-block;
            border: 1px solid grey;
            border-bottom: 3px solid grey;
            background-color: white;
        }

            .tabs ul li.active {
                border: 1px solid black;
                border-bottom: 3px solid white;
            }

            .tabs ul li a {
                text-decoration: none;
                color: grey;
                padding: 10px;
                line-height: 25px;
                position: relative;
                font-weight: bold;
            }

    .tab-content-wrapper {
        position: relative !important;
        z-index: 1 !important;
        border: 3px solid grey;
        padding: 20px;
        min-height: 40px;
    }

    select#cmbfyyear {
        font-weight: bold;
        font-size:20px;
    }


    #resp-table {
        width: 100%;
        display: table;
    }

    #resp-table-body {
        display: table-row-group;
    }

    .resp-table-row {
        display: table-row;
    }

    .table-body-cell {
        display: table-cell;
        border: 1px solid #dddddd;
        padding: 8px;
        line-height: 1.42857143;
        vertical-align: top;
    }

    /* Profit & Loss Details card */
    .pnl-card { background:#fff; border:1px solid #e6e6ef; border-radius:8px; padding:18px 22px; box-shadow:0 1px 2px rgba(0,0,0,.03); }
    .pnl-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px; }
    .pnl-title { font-size:18px; font-weight:600; color:#1a1a2e; }
    .pnl-range { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .pnl-range-label { color:#666; font-size:14px; margin-right:4px; }
    .pnl-chip { border:1px solid #e0e0e8; background:#fff; color:#333; padding:6px 14px; border-radius:6px; font-size:13px; cursor:pointer; }
    .pnl-chip:hover { background:#f5f5fa; }
    .pnl-chip.active { background:#eef1ff; border-color:#6b7cff; color:#4a5ae8; font-weight:600; }
    .pnl-custom-date { border:1px solid #e0e0e8; border-radius:6px; padding:5px 8px; font-size:13px; width:110px; }
    .pnl-download { margin-left:8px; border:1.5px solid #4a5ae8; background:#fff; color:#4a5ae8; padding:6px 16px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; letter-spacing:.3px; }
    .pnl-download:hover { background:#eef1ff; }

    .pnl-summary { display:flex; gap:0; border-top:1px solid #eee; border-bottom:1px solid #eee; padding:14px 0; }
    .pnl-summary-item { flex:1; display:flex; align-items:center; gap:12px; padding:0 20px; border-right:1px solid #f0f0f0; }
    .pnl-summary-item:last-child { border-right:none; }
    .pnl-summary-icon { width:36px; height:36px; border-radius:50%; background:#e8f5ee; color:#2d9d5f; display:flex; align-items:center; justify-content:center; font-weight:700; }
    .pnl-summary-label { color:#666; font-size:13px; }
    .pnl-summary-value { font-size:17px; font-weight:700; color:#1a1a2e; margin-top:2px; }

    .pnl-range-display { text-align:center; margin:14px 0 8px; }
    .pnl-range-display span { display:inline-block; background:#eaf6ef; color:#2d9d5f; padding:6px 18px; border-radius:20px; font-size:13px; font-weight:500; }

    .pnl-calendar-wrapper { overflow-x:auto; padding:14px 0 20px; }
    .pnl-calendar { display:flex; gap:4px; min-width:1200px; border-bottom:2px solid #b8d8c4; padding-bottom:36px; position:relative; }
    .pnl-month { flex:1; min-width:150px; text-align:center; position:relative; padding:0 6px; }
    .pnl-month-label { font-size:16px; color:#555; margin-bottom:12px; font-weight:600; }
    .pnl-month-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:6px; padding:0 10px; }
    .pnl-day { width:14px; height:14px; border-radius:50%; background:#eef0f4; margin:auto; }
    .pnl-day.profit-sm { background:#a3d9b6; }
    .pnl-day.profit-md { background:#4fb977; }
    .pnl-day.profit-lg { background:#2d9d5f; }
    .pnl-day.loss-sm  { background:#f4b0b0; }
    .pnl-day.loss-md  { background:#e56b6b; }
    .pnl-day.loss-lg  { background:#c62828; }
    .pnl-month-total { position:absolute; bottom:-30px; left:0; right:0; text-align:center; font-size:15px; font-weight:700; }
    .pnl-month-total.profit { color:#2d9d5f; }
    .pnl-month-total.loss { color:#c62828; }

    .pnl-legend { margin-top:14px; text-align:right; font-size:12px; color:#666; }
    .pnl-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin:0 3px; vertical-align:middle; }
    .pnl-dot-loss { background:#e56b6b; }
    .pnl-dot-profit { background:#2d9d5f; }
</style>
