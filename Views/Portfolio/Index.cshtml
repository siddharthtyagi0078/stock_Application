@{
    ViewData["Title"] = "Portfolio";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous" />
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">


<style>

    .summary-card {
        background: linear-gradient(135deg, #f9fbff, #ffffff);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        font-size: 16px;
    }

        .summary-row strong {
            font-size: 17px;
        }

    .summary-divider {
        border-top: 1px dashed #ccc;
        margin: 12px 0;
    }

    .summary-net {
        text-align: center;
        margin-top: 15px;
    }

        .summary-net span {
            font-size: 14px;
            color: #666;
        }

        .summary-net div {
            font-size: 28px;
            font-weight: 700;
           
            margin-top: 5px;
        }

    body { background:#f2f5f9; font-family:Segoe UI; }
    .container { width:1100px; margin:30px auto; background:#fff; padding:20px; border-radius:10px; box-shadow:0 5px 20px rgba(0,0,0,.1);}
    .header { display:flex; justify-content:space-between; margin-bottom:15px; }
    input{ padding:8px 12px; }
    button{ padding:8px 15px; background:#1f6fff; color:white; border:none; border-radius:4px; }

    table{ width:100%; border-collapse:collapse; margin-top:15px; }
    th,td{ border:1px solid #ddd; padding:10px; text-align:center; }
    th{ background:#1f6fff; color:white; }

    .flex{ display:flex; gap:20px; margin-top:20px; }
    .card{ flex:1; border:1px solid #ddd; border-radius:8px; padding:15px; }
    .card h3{ margin-bottom:10px; border-bottom:1px solid #ccc; padding-bottom:5px; }

    .profit {
        color: #16a34a;
        font-weight: 600;
    }

    .loss {
        color: #dc2626;
        font-weight: 600;
    }

    .net{ font-size:22px; font-weight:600; color:green; text-align:center; margin-top:15px; }
</style>

<div class="vh-100">

    <div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"> </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <img src="~/images/logo.jpg" style="height:50px;" />
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="/Reports" asp-action="Index">Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="/Nifty50" asp-action="Index">Nifty50</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="/FiiDaily" asp-action="Index">FII Report</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="/portfolio" asp-action="Index">Stock Report</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="/Orders" asp-action="Index">Option Chain</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>


    </div>
    <div class="header">
        <h2>Stock Portfolio</h2>
        <br />
        <div>
            <input type="text" id="searchBox" placeholder="Search Stock..." />
            <button onclick="loadData()">Search</button>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>S.No</th>
                <th>Name</th>
                <th>Hold</th>

                <th>Qty</th>
                <th>Buy</th>
                <th>Sell</th>
                <th>Total P/L</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody id="stockTable"></tbody>
    </table>
    <button style="margin-top:10px" onclick="openModal()">+ Add Dividend</button>

    <div class="flex">
        <div class="card">
            <h3>Dividend</h3>
            <table>
                <thead>
                    <tr>
                        <th style="width:60%">Date</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody id="dividendTable"></tbody>
            </table>

        </div>
        <div class="card summary-card">
            <h3>Summary</h3>

            <div class="summary-row">
                <span>Total Profit / Loss</span>
                <strong id="totalPLText">₹0</strong>
            </div>

            <div class="summary-row">
                <span>Total Dividend</span>
                <strong id="dividendText">₹0</strong>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-net">
                <span>Net Earnings</span>
                <div id="netBox">₹0</div>
            </div>
        </div>

    </div>
</div>

<div id="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.4)">
    <div style="background:white; width:300px; margin:120px auto; padding:20px; border-radius:8px">
        <h3>Add Dividend</h3>
        <input type="date" id="divDate" style="width:100%; margin-bottom:10px">
        <input type="number" id="divAmount" placeholder="Amount" style="width:100%; margin-bottom:10px">
        <button onclick="saveDividend()">Save</button>
        <button onclick="closeModal()" style="background:gray">Cancel</button>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>


<script>
    let totalPL = 0;
    let totalDividend = 0;
    function formatMoney(value) {
        return '₹' + Number(value).toLocaleString('en-IN', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }) + '/-';
    }


      function loadData(){

            let script_code = $('#searchBox').val();
        $.get('/Portfolio/GetPortfolioData', { script_code },function(res){

            totalPL = 0;
            totalDividend = 0;
            debugger;
            $('#stockTable').html('');

            res.stocks.forEach(s=>{
                totalPL += s.totalPL;

                $('#stockTable').append(`
                    <tr>
                        <td>${s.sNo}</td>
                        <td>${s.name}</td>
                        <td>${s.duration}</td>
                        <td>${s.qty}</td>
                        <td>${formatMoney(s.buy)}</td>
                        <td>${formatMoney(s.sell)}</td>
                        <td class="${s.totalPL < 0 ? 'loss' : 'profit'}">
        ${formatMoney(s.totalPL)}
    </td>

                        <td>${s.date}</td>
                    </tr>
                `);
            });

            updateSummary();
            loadDividends();
        });
    }

     $("#searchBox").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Reports/Index",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.name, value: item.code };
                        }))
                    }
                })
            },
            messages: {
                noResults: "", results: ""
            }
        });

     function loadDividends() {
           let script_code = $('#searchBox').val();
        $.get('/Portfolio/GetDividends',{script_code}, function (res) {

            totalDividend = 0;
            $('#dividendTable').html('');

            res.forEach(d => {
                totalDividend += d.amount;

                $('#dividendTable').append(`
                    <tr>
                        <td>${d.date}</td>
                        <td>${formatMoney(d.amount)}</td>
                    </tr>
                `);
            });

            updateSummary();
        });
    }


        function updateSummary(){
        $('#totalPLText').text(formatMoney(totalPL));
        $('#dividendText').text(formatMoney(totalDividend));
        $('#netBox').text(formatMoney(totalPL + totalDividend));

        const plEl = $('#totalPLText');

        if (totalPL < 0) {
            plEl.removeClass('profit').addClass('loss');
        } else {
            plEl.removeClass('loss').addClass('profit');
        }
        debugger
          const netBox = $('#netBox');
              if ( netBox.text().toLowerCase().startsWith("₹-")) {
            netBox.removeClass('profit').addClass('loss');
        } else {
            netBox.removeClass('loss').addClass('profit');
        }


    }


    function applyPLColor() {
        const el = $('#totalPLText');

        if (globalTotalPL < 0) {
            el.css('color', '#dc2626');
        } else {
            el.css('color', '#16a34a');
        }
    }

    function openModal() { $('#modal').show(); }
    function closeModal() { $('#modal').hide(); }

    function saveDividend() {
        let date = $('#divDate').val();
        let amount = $('#divAmount').val();
          let script_code = $('#searchBox').val();
        $.post('/Portfolio/AddDividend', { script_code,date, amount }, function () {
            closeModal();
            loadData();
        });
    }

    $(document).ready(loadData);

     
</script>

