@model StockWebApplications.Models.LoginModel

@{
    ViewData["Title"] = "Login Page";
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<section class="vh-100" style="background-color: #9A616D;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-xl-10">
                <div class="card" style="border-radius: 1rem;">
                    <div class="row g-0">
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <img src="~/images/img.webp" style="width:1200px;margin-bottom:5px;"
                                 alt="login form" class="img-fluid" style="border-radius: 1rem 0 0 1rem;" />
                               
                                  <img src="~/images/img3.jpg"
                                 alt="login form" class="img-fluid" style="border-radius: 1rem 0 0 1rem;" />
                        </div>
                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                @using (Html.BeginForm("Create", "Login", FormMethod.Post))
                                {

                                    <div class="d-flex align-items-center mb-3 pb-1">
                                        <i class="fas fa-cubes fa-2x me-3" style="color: #ff6219;"></i>
                                        <span class="h1 fw-bold mb-0">Stock Market Portfolio Manager</span>
                                    </div>

                                    <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Sign into your account</h5>

                                    <div class="form-outline mb-4">
                                         @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control form-control-lg" } })

                                        <label class="form-label" for="form2Example17">Email address</label>
                                    </div>

                                    <div class="form-outline mb-4">
                                         @Html.PasswordFor(model => model.Password, new { @class = "form-control form-control-lg" } )

                                        <label class="form-label" for="form2Example27">Password</label>
                                    </div>

                                    <div class="pt-1 mb-4">
                                         <input type="submit" value="Login" class="btn btn-dark btn-lg btn-block" />
                                        <p class="mb-5 pb-lg-2" style="color: #393f81;">   <br />   <br /> <b> v 3.0  Released on:- 18-Mar-2024 </b>
                                  </p>
                                        </div>
                                      @*  <div class="pt-1 mb-4">
                            
                              
                                      <img src="~/images/US-Stocks2_PDP-min.webp"
                                 alt="login form" class="img-fluid" style="border-radius: 1rem 0 0 1rem;" />
                        </div>*@
                                    @*<a class="small text-muted" href="#!">Forgot password?</a>
                                    <p class="mb-5 pb-lg-2" style="color: #393f81;">
                                       <a href="#!"
                                                                  style="color: #393f81;">Version 2.0</a>
                                    </p>
                                    <a href="#!" class="small text-muted">Terms of use.</a>
                                    <a href="#!" class="small text-muted">Privacy policy</a>*@
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>