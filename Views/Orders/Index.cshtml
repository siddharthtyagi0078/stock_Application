<h2>Trade Report</h2>

<div class="container-fluid mt-3">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4>Create Option Strategy</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label>Strategy Name</label>
                    <input type="text"
                           id="StrategyName"
                           class="form-control"
                           placeholder="Covered Call / Short Strangle" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Symbol</label>
                    <input type="text"
                           id="Symbol"
                           class="form-control"
                           placeholder="MAZDOCK" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>Expiry (default for legs)</label>
                    <input type="date"
                           id="ExpiryDate"
                           class="form-control" />
                </div>

                <div class="col-md-1 mb-3">
                    <label>Lot Size</label>
                    <input type="number"
                           id="LotSize"
                           class="form-control"
                           value="225" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>Remarks</label>
                    <input type="text"
                           id="Remarks"
                           class="form-control" />
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between mb-2">

                <h5>Strategy Legs</h5>

                <button type="button"
                        id="btnAddRow"
                        class="btn btn-success">
                    + Add Leg
                </button>

            </div>

            <table class="table table-bordered table-striped" id="tblLegs">

                <thead>

                    <tr>

                        <th width="60">Leg</th>

                        <th width="120">Action</th>

                        <th width="140">Instrument</th>

                        <th width="150">Expiry</th>

                        <th width="120">Strike</th>

                        <th width="120">Trade Price</th>

                        <th width="100">Quantity</th>

                        <th width="70">Delete</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td class="legNo">
                            1
                        </td>

                        <td>

                            <select class="form-control action">

                                <option value="BUY">BUY</option>

                                <option value="SELL" selected>
                                    SELL
                                </option>

                            </select>

                        </td>

                        <td>

                            <select class="form-control instrument">

                                <option value="FUTURE">
                                    FUTURE
                                </option>

                                <option value="CE">
                                    CE
                                </option>

                                <option value="PE">
                                    PE
                                </option>

                            </select>

                        </td>

                        <td>

                            <input type="date"
                                   class="form-control expiry" />

                        </td>

                        <td>

                            <input type="number"
                                   class="form-control strike" />

                        </td>

                        <td>

                            <input type="number"
                                   step="0.01"
                                   class="form-control price" />

                        </td>

                        <td>

                            <input type="number"
                                   class="form-control qty"
                                   value="225" />

                        </td>

                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-danger btnDelete">

                                X

                            </button>

                        </td>

                    </tr>

                </tbody>

            </table>

            <hr />

            <div class="text-center">

                <button type="button"
                        id="btnSave"
                        class="btn btn-primary btn-lg">

                    Save Strategy

                </button>

            </div>

        </div>

    </div>

    <!-- =====================================================
         Existing strategies: expand to add / remove legs
    ====================================================== -->
    <div class="card shadow mt-4">

        <div class="card-header bg-primary text-white">
            <h4>Strategies</h4>
        </div>

        <div class="card-body">

            <table class="table table-bordered" id="tblStrategies">
                <thead>
                    <tr>
                        <th width="60"></th>
                        <th>Strategy</th>
                        <th>Symbol</th>
                        <th>Expiry</th>
                        <th>Lot</th>
                        <th>Legs</th>
                        <th>Premium</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>

    </div>

</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    $(document).ready(function () {

        LoadStrategies();

        //---------------------------------------------------------
        // Copy Lot Size to Qty
        //---------------------------------------------------------

        $("#LotSize").on("keyup change", function () {

            var lot = $(this).val();

            $(".qty").val(lot);

        });

        //---------------------------------------------------------
        // Master Expiry acts as a default: fill legs left empty
        //---------------------------------------------------------

        $("#ExpiryDate").on("change", function () {

            var exp = $(this).val();

            $(".expiry").each(function () {
                if ($(this).val() == "") $(this).val(exp);
            });

        });

        //---------------------------------------------------------
        // Disable Strike when FUTURE selected
        //---------------------------------------------------------

        $(document).on("change", ".instrument", function () {

            var row = $(this).closest("tr");

            var instrument = $(this).val();

            if (instrument == "FUTURE") {

                row.find(".strike")
                    .val("")
                    .prop("disabled", true);

            }
            else {

                row.find(".strike")
                    .prop("disabled", false);

            }

        });

        //---------------------------------------------------------
        // Add New Row
        //---------------------------------------------------------

        $("#btnAddRow").click(function () {

            var rowCount = $("#tblLegs tbody tr").length + 1;

            var qty = $("#LotSize").val();

            var html = "";

            html += "<tr>";

            html += "<td class='legNo'>" + rowCount + "</td>";

            html += "<td>";
            html += "<select class='form-control action'>";
            html += "<option value='BUY'>BUY</option>";
            html += "<option value='SELL' selected>SELL</option>";
            html += "</select>";
            html += "</td>";

            html += "<td>";
            html += "<select class='form-control instrument'>";
            html += "<option value='FUTURE'>FUTURE</option>";
            html += "<option value='CE'>CE</option>";
            html += "<option value='PE'>PE</option>";
            html += "</select>";
            html += "</td>";

            html += "<td>";
            html += "<input type='date' class='form-control expiry' value='" + $("#ExpiryDate").val() + "' />";
            html += "</td>";

            html += "<td>";
            html += "<input type='number' class='form-control strike' disabled />";
            html += "</td>";

            html += "<td>";
            html += "<input type='number' step='0.01' class='form-control price'/>";
            html += "</td>";

            html += "<td>";
            html += "<input type='number' class='form-control qty' value='" + qty + "'/>";
            html += "</td>";

            html += "<td class='text-center'>";
            html += "<button class='btn btn-danger btnDelete'>X</button>";
            html += "</td>";

            html += "</tr>";

            $("#tblLegs tbody").append(html);

        });

        //---------------------------------------------------------
        // Delete Row
        //---------------------------------------------------------

        $(document).on("click", ".btnDelete", function () {

            if ($("#tblLegs tbody tr").length == 1) {

                alert("At least one leg is required.");

                return;

            }

            $(this).closest("tr").remove();

            RenumberLegs();

        });

        //---------------------------------------------------------
        // Save
        //---------------------------------------------------------

        $("#btnSave").click(function () {

            if ($("#StrategyName").val() == "") {

                alert("Enter Strategy Name");

                return;
            }

            if ($("#Symbol").val() == "") {

                alert("Enter Symbol");

                return;
            }

            var missingExpiryLeg = 0;

            $("#tblLegs tbody tr").each(function (index) {
                if ($(this).find(".expiry").val() == "" && $("#ExpiryDate").val() == "" && missingExpiryLeg == 0) {
                    missingExpiryLeg = index + 1;
                }
            });

            if (missingExpiryLeg > 0) {
                alert("Enter Expiry for leg " + missingExpiryLeg + " (or set the default Expiry)");
                return;
            }

            var strategy = {};

            strategy.StrategyName = $("#StrategyName").val();
            strategy.Symbol = $("#Symbol").val();
            strategy.LotSize = $("#LotSize").val();
            strategy.Remarks = $("#Remarks").val();

            strategy.Legs = [];

            var earliestExpiry = "";

            $("#tblLegs tbody tr").each(function (index) {

                var row = $(this);

                var leg = {};

                leg.LegNo = index + 1;
                leg.ActionType = row.find(".action").val();
                leg.InstrumentType = row.find(".instrument").val();

                var strike = row.find(".strike").val();

                if (strike == "")
                    strike = null;

                leg.StrikePrice = strike;

                var legExpiry = row.find(".expiry").val();

                if (legExpiry == "")
                    legExpiry = $("#ExpiryDate").val();

                leg.ExpiryDate = legExpiry;

                if (earliestExpiry == "" || legExpiry < earliestExpiry)
                    earliestExpiry = legExpiry;

                leg.TradePrice = row.find(".price").val();
                leg.Quantity = row.find(".qty").val();

                strategy.Legs.push(leg);

            });

            // Master expiry kept for the dashboard summary row: default field, else earliest leg expiry.
            strategy.ExpiryDate = $("#ExpiryDate").val() != "" ? $("#ExpiryDate").val() : earliestExpiry;

            console.log(strategy);

            $("#btnSave").prop("disabled", true);

            $.ajax({
                url: '@Url.Action("Create", "Orders")',
                type: 'POST',
                data: strategy,
                success: function (response) {

                    $("#btnSave").prop("disabled", false);

                    // Json() may camelCase keys depending on serializer settings.
                    var ok = response && (response.Success || response.success);
                    var msg = response && (response.Message || response.message);
                    var name = response && (response.StrategyName || response.strategyName);

                    if (ok) {
                        var summary = response.Summary || response.summary;
                        var msg = "Strategy '" + (name || strategy.StrategyName) + "' saved successfully.";
                        if (summary) msg += "\n\nAI Summary:\n" + summary;
                        alert(msg);
                        ResetStrategyForm();
                        LoadStrategies();
                    }
                    else {
                        alert("Save failed: " + (msg || "Unknown error"));
                    }
                },
                error: function () {
                    $("#btnSave").prop("disabled", false);
                    alert("Unable to save strategy. Please try again.");
                }
            });

        });

    });


    //---------------------------------------------------------
    // Reset form after a successful save
    //---------------------------------------------------------

    function ResetStrategyForm() {

        $("#StrategyName").val("");
        $("#Symbol").val("");
        $("#ExpiryDate").val("");
        $("#LotSize").val("225");
        $("#Remarks").val("");

        $("#tblLegs tbody").empty();

        var html = "";

        html += "<tr>";

        html += "<td class='legNo'>1</td>";

        html += "<td>";
        html += "<select class='form-control action'>";
        html += "<option value='BUY'>BUY</option>";
        html += "<option value='SELL' selected>SELL</option>";
        html += "</select>";
        html += "</td>";

        html += "<td>";
        html += "<select class='form-control instrument'>";
        html += "<option value='FUTURE'>FUTURE</option>";
        html += "<option value='CE'>CE</option>";
        html += "<option value='PE'>PE</option>";
        html += "</select>";
        html += "</td>";

        html += "<td>";
        html += "<input type='date' class='form-control expiry' />";
        html += "</td>";

        html += "<td>";
        html += "<input type='number' class='form-control strike' />";
        html += "</td>";

        html += "<td>";
        html += "<input type='number' step='0.01' class='form-control price'/>";
        html += "</td>";

        html += "<td>";
        html += "<input type='number' class='form-control qty' value='225'/>";
        html += "</td>";

        html += "<td class='text-center'>";
        html += "<button type='button' class='btn btn-danger btnDelete'>X</button>";
        html += "</td>";

        html += "</tr>";

        $("#tblLegs tbody").append(html);
    }

    //---------------------------------------------------------
    // Renumber Legs
    //---------------------------------------------------------

    function RenumberLegs() {

        $("#tblLegs tbody tr").each(function (index) {

            $(this).find(".legNo").html(index + 1);

        });

    }

    //---------------------------------------------------------
    // Existing strategies list (add / remove legs)
    //---------------------------------------------------------

    function fmtDate(d) {
        if (!d) return "-";
        var dt = new Date(d);
        if (isNaN(dt.getTime()) || dt.getFullYear() < 1970) return "-";
        return dt.toLocaleDateString('en-GB');
    }

    function toDateInputValue(d) {
        if (!d) return "";
        var dt = new Date(d);
        if (isNaN(dt.getTime()) || dt.getFullYear() < 1970) return "";
        return dt.toISOString().substring(0, 10);
    }

    function LoadStrategies() {

        $.getJSON('@Url.Action("GetStrategies", "Orders")', function (data) {

            var tbody = $('#tblStrategies tbody');
            tbody.empty();

            if (!data || !data.length) {
                tbody.append('<tr><td colspan="7" class="text-center">No strategies found.</td></tr>');
                return;
            }

            $.each(data, function (i, s) {

                var sid = s.strategyId != null ? s.strategyId : s.StrategyId;
                var name = s.strategyName || s.StrategyName || "";
                var symbol = s.symbol || s.Symbol || "";
                var expiry = s.expiryDate || s.ExpiryDate;
                var lot = s.lotSize != null ? s.lotSize : s.LotSize;
                var legs = s.legs || s.Legs || [];
                var premium = s.totalPremium != null ? s.totalPremium : s.TotalPremium;

                var row = "";
                row += "<tr>";
                row += "<td class='text-center'><button type='button' class='btn btn-sm btn-primary btnToggleLegs' data-strategyid='" + sid + "'>+</button></td>";
                row += "<td>" + name + "</td>";
                row += "<td>" + symbol + "</td>";
                row += "<td>" + fmtDate(expiry) + "</td>";
                row += "<td>" + lot + "</td>";
                row += "<td>" + legs.length + "</td>";
                row += "<td><span style='font-weight:bold;color:green;'>&#8377; " + premium + "</span></td>";
                row += "</tr>";

                // hidden legs panel
                var panel = "";
                panel += "<tr class='legs-panel' data-strategyid='" + sid + "' style='display:none;'>";
                panel += "<td colspan='7'>";
                panel += "<table class='table table-sm table-bordered mb-0'>";
                panel += "<thead class='table-light'><tr>";
                panel += "<th>Leg</th><th>Action</th><th>Instrument</th><th>Expiry</th><th>Strike</th><th>Trade Price</th><th>Qty</th><th width='90'></th>";
                panel += "</tr></thead><tbody>";

                $.each(legs, function (j, leg) {

                    var legId = leg.legId != null ? leg.legId : leg.LegId;
                    var legNo = leg.legNo != null ? leg.legNo : leg.LegNo;
                    var action = leg.actionType || leg.ActionType || "";
                    var instrument = leg.instrumentType || leg.InstrumentType || "";
                    var legExpiry = leg.expiryDate || leg.ExpiryDate;
                    var strike = leg.strikePrice != null ? leg.strikePrice : leg.StrikePrice;
                    var price = leg.tradePrice != null ? leg.tradePrice : leg.TradePrice;
                    var qty = leg.quantity != null ? leg.quantity : leg.Quantity;

                    var actionColor = action == "BUY" ? "green" : "red";

                    panel += "<tr>";
                    panel += "<td>" + legNo + "</td>";
                    panel += "<td><span style='font-weight:bold;color:" + actionColor + "'>" + action + "</span></td>";
                    panel += "<td>" + instrument + "</td>";
                    panel += "<td>" + fmtDate(legExpiry) + "</td>";
                    panel += "<td>" + (strike == null ? "-" : strike) + "</td>";
                    panel += "<td>" + price + "</td>";
                    panel += "<td>" + qty + "</td>";
                    panel += "<td class='text-center'><button type='button' class='btn btn-sm btn-danger btnRemoveLeg' data-legid='" + legId + "'>Remove</button></td>";
                    panel += "</tr>";

                });

                // add-leg input row
                panel += "<tr class='add-leg-row'>";
                panel += "<td class='text-center'><strong>New</strong></td>";
                panel += "<td><select class='form-control nl-action'><option value='BUY'>BUY</option><option value='SELL' selected>SELL</option></select></td>";
                panel += "<td><select class='form-control nl-instrument'><option value='FUTURE'>FUTURE</option><option value='CE'>CE</option><option value='PE'>PE</option></select></td>";
                panel += "<td><input type='date' class='form-control nl-expiry' value='" + toDateInputValue(expiry) + "' /></td>";
                panel += "<td><input type='number' class='form-control nl-strike' /></td>";
                panel += "<td><input type='number' step='0.01' class='form-control nl-price' /></td>";
                panel += "<td><input type='number' class='form-control nl-qty' value='" + lot + "' /></td>";
                panel += "<td class='text-center'><button type='button' class='btn btn-sm btn-success btnAddLegExisting' data-strategyid='" + sid + "'>Add</button></td>";
                panel += "</tr>";

                panel += "</tbody></table>";
                panel += "</td></tr>";

                tbody.append(row + panel);

            });

        });

    }

    //---------------------------------------------------------
    // Expand / collapse a strategy's legs
    //---------------------------------------------------------

    $(document).on("click", ".btnToggleLegs", function () {

        var sid = $(this).data("strategyid");
        var panel = $(".legs-panel[data-strategyid='" + sid + "']");

        panel.toggle();

        $(this).text(panel.is(":visible") ? "-" : "+");

    });

    //---------------------------------------------------------
    // Remove a leg from an existing strategy
    //---------------------------------------------------------

    $(document).on("click", ".btnRemoveLeg", function () {

        var legId = $(this).data("legid");

        if (!confirm("Remove this leg from the strategy? (This deletes it — use Exit on the dashboard to close at a price.)"))
            return;

        $.post('@Url.Action("RemoveLeg", "Orders")', { legId: legId }, function (resp) {

            if (resp && (resp.success || resp.Success)) {
                LoadStrategies();
            }
            else {
                alert("Unable to remove leg: " + ((resp && (resp.message || resp.Message)) || "unknown error"));
            }

        }).fail(function () {
            alert("Unable to remove leg.");
        });

    });

    //---------------------------------------------------------
    // Add a leg to an existing strategy
    //---------------------------------------------------------

    $(document).on("click", ".btnAddLegExisting", function () {

        var btn = $(this);
        var sid = btn.data("strategyid");
        var rowEl = btn.closest("tr");

        var instrument = rowEl.find(".nl-instrument").val();
        var strike = rowEl.find(".nl-strike").val();
        var expiry = rowEl.find(".nl-expiry").val();
        var price = rowEl.find(".nl-price").val();
        var qty = rowEl.find(".nl-qty").val();

        if (expiry == "") { alert("Enter expiry for the new leg"); return; }
        if (instrument != "FUTURE" && strike == "") { alert("Enter strike for the new leg"); return; }
        if (price == "") { alert("Enter trade price for the new leg"); return; }
        if (qty == "") { alert("Enter quantity for the new leg"); return; }

        var leg = {
            StrategyId: sid,
            ActionType: rowEl.find(".nl-action").val(),
            InstrumentType: instrument,
            StrikePrice: strike == "" ? null : strike,
            ExpiryDate: expiry,
            TradePrice: price,
            Quantity: qty
        };

        btn.prop("disabled", true);

        $.post('@Url.Action("AddLeg", "Orders")', leg, function (resp) {

            btn.prop("disabled", false);

            if (resp && (resp.success || resp.Success)) {
                LoadStrategies();
            }
            else {
                alert("Unable to add leg: " + ((resp && (resp.message || resp.Message)) || "unknown error"));
            }

        }).fail(function () {
            btn.prop("disabled", false);
            alert("Unable to add leg.");
        });

    });

</script>