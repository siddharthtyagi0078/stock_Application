    function  MoodDesc(val)
    {
      //  alert(val);
        $('#l30').hide();
        $('#l3050').hide();
        $('#l5070').hide();
        $('#lg70').hide();

        if (val <= 30) {
            $('#l30').show();
            $('#val1').text(val);
        }
