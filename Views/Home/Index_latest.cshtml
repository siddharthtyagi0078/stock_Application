    function toggleAll(source){
 
        var iscollapsed = $('#hdncollapse').val();
       if(source=='link')
       {
            $('#hdncollapse').val(1 - iscollapsed);
       }
         iscollapsed = $('#hdncollapse').val();
       // alert(source);
      //  int i=1;
        for (i = 1; i < stockcount+1; i++)
        {
           if(iscollapsed==0){
            $('#toggleg1'+i).show();
                $('#toggleg2' + i).show();
                $('#toggleg3' + i).show();
                $('#hdncollapse').val("0");
           }
            if (iscollapsed == 1) {
                $('#toggleg1' + i).hide();
                $('#toggleg2' + i).hide();
                $('#toggleg3' + i).hide();
                $('#hdncollapse').val("1");
            }
        }
      
