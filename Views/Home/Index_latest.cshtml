    function AddStock() {
        debugger;
        if ($('#txtStock').val() == '') {
            alert('Please enter stock');
            $('#txtStock').focus();
            return false;
        }
        if ($('#txtStockDate').val() == '') {
            alert('Please enter stock date');
            $('#txtStockDate').focus();
            return false;
        }
