              //  loadData();
            },
            error: function (errormessage) {
                alert('error');
            }
        });
    }
  
    var min_value = 0;
    var max_value = 0;
    function CalculateData(jsonObj) {
        var totalinvestedv = 0;
        var indices_c=0; 
        var plus_count=0;
        var overallgain = 0;
        var todygain = 0;
         min_value=0;
         max_value=0;
        var max_comp="";
        var min_comp="";
         $('#DvFII' ).html('FII Data<hr/>');
        stockcount=jsonObj.length;
        var profatble_val=0;
        adv = 0;
        dec = 0;
        for (i = 0; i < jsonObj.length;i++)
        {
            totalinvestedv += parseFloat(jsonObj[i].shares) * parseFloat(jsonObj[i].inv_Price);
            overallgain += parseFloat(jsonObj[i].overAllGain);
            todygain += parseFloat(jsonObj[i].daysGain);
            if (jsonObj[i].daysGain < min_value) {
                min_value = jsonObj[i].daysGain;
                min_comp = jsonObj[i].Company_name;
            } 
            if (jsonObj[i].overAllGain>0)
            {
                plus_count++;
                    if (jsonObj[i].overAllGain>1000)
                    {
                        profatble_val += jsonObj[i].latestValue;
                    }
            }
            // find maximum value
            if (jsonObj[i].daysGain > max_value) {
                max_value = jsonObj[i].daysGain;
                max_comp = jsonObj[i].Company_name;
            }
            if (jsonObj[i].daysGain>0)
            {
                adv++;
            }
            else
            {
                dec++;
            }
            if(jsonObj[i].stock_listing!=null)
            {
                 $('#stocklisttrend' ).html('<div id="psummaryval" >Portfolio Trend </div><hr/>'+jsonObj[i].stock_listing+'<hr/>');
            }
          
            if(jsonObj[i].FIIData!='')
            {
                 $('#DvFII' ).append(jsonObj[i].Company_name+'<br/>'+jsonObj[i].FIIData+'<hr/>');
            }
            if(indices_c==0)//for indices only
            {
                try
                {
                    //$('#stocklisttrend' ).html('<div id="psummaryval" >Portfolio Trend </div><hr/>'+jsonObj[i].stock_listing+'<hr/>');

                if(jsonObj[i].Indices!=null)
                {
                indices_c=1;
                
                $('#nvix' ).html( jsonObj[i].Indices[0].index_html);
                $('#nindex' ).html( jsonObj[i].Indices[1].index_html);
                $('#nbankindex').html(jsonObj[i].Indices[2].index_html);
                }
               
              //  $('#sample').html(jsonObj[i].indicesText);
                for (j = 0; j < 3; j++)
                {
                var cname = jsonObj[i].Indices[j].companyName;
                var cclose = jsonObj[i].Indices[j].close;
                    var cchange = jsonObj[i].Indices[j].change;// ;

                    $('#indices'+j).text(cname);
                    $('#indicesval'+j).text(cclose);
                    $('#indiceschange' + j).text(cchange+ " (" + jsonObj[i].Indices[j].changepercent + "%)");
 

                    setstyle('indiceschange' + j, cchange);
                    setstyle('indicesval' + j, cchange);
                    //setstyle('todaygain',todygain);
                    //setstyle('todaygain', todygain);
                    }
                }
                  catch(err) { 
               // alert(err);
                }
            }
        }
        MoodDesc(jsonObj[0].MMood);

         var col="red";
                    if(todygain>=0)
                    {col="green";
                    }
                    var total= 'Today:- <span id="todaygain1"  style="font-size: 22px;color: '+col+'; font-weight: bolder;margin-bottom:5px;"></span>';
                 //   $('#stocklisttrend' ).append(total);
                 
                     col="red";
                    if(overallgain>=0)
                    {col="green";
                    }
                       var overall= ' <span  style="font-size: 26px;" >| Total</span> <span id="todaygain2"  style="font-size: 24px;color: '+col+'; font-weight: bolder;margin-bottom:5px;"></span>';

               //     $('#stocklisttrend' ).append(overall);
                    $('#psummaryval' ).html(total+overall);

                    


      var overallpercent = parseFloat(overallgain / totalinvestedv)*100;
        $('#totalinvested').text('₹' + totalinvestedv.toLocaleString('en-IN'));
        var todaysg = parseFloat(todygain / totalinvestedv) * 100;
        $('#todaygain').text('₹' + todygain.toLocaleString('en-IN') + "(" + (todaysg.toFixed(2)) + "%)");
        $('#todaygain1').text('₹' + todygain.toLocaleString('en-IN') + "(" + (todaysg.toFixed(2)) + "%)");
        $('#todaygain2').text('₹' + overallgain.toLocaleString('en-IN') + "(" + (overallpercent.toFixed(2)) + "%)");


  
        $('#overallgain').text('₹' + overallgain.toLocaleString('en-IN') + "(" + (overallpercent.toFixed(2)) + "%)");
$('#dvcount').text(" ["+plus_count+" / "+jsonObj.length+"]");
        var finalvalue = parseFloat(overallgain) + parseFloat(totalinvestedv);
        $('#finalvalue').text('₹' + (finalvalue).toLocaleString('en-IN'));
        $('#totalwithdraw').text('₹' + (profatble_val).toLocaleString('en-IN') + " (" + ((profatble_val / totalinvestedv) * 100).toFixed(2) + "%)");
      //  setstyle('totalinvested', totalinvestedv);
        setstyle('todaygain',todygain);
        setstyle('overallgain',overallgain);
        setstyle('finalvalue', finalvalue);
        setstyle('totalwithdraw', profatble_val);

        $('#dadv').html(adv);
        $('#ddec').html(dec);

        $('#indices').html(jsonObj[0].Indices);

        const d = new Date();
        let name = month[d.getMonth()];
       
        $('#dvmonthlyprofit').text('P/L for [' + name + '- ' + d.getFullYear() + ']-> ₹' + (jsonObj[0].monthly_profit).toLocaleString('en-IN')+'/-');
        var finalMonthly=jsonObj[0].monthly_profit+jsonObj[0].dividend;

        if (jsonObj[0].monthly_profit >=0) {
            $('#dvmonthlyprofit').attr("style", "color: green;");
           // $('#dvmonthlyprofit').attr("class", "upMrktS");
        }
        else {
            $('#dvmonthlyprofit').attr("style", "color: red;");
            //$('#dvmonthlyprofit').attr("class", "downMrktS");

        }
        $('#dvmonthTotal').text('Total P/L[' + name + '- ' + d.getFullYear() + ']-> ₹' + (finalMonthly).toLocaleString('en-IN')+'/-');

        if (finalMonthly >=0) {
            $('#dvmonthTotal').attr("style", "color: green;");
           // $('#dvmonthlyprofit').attr("class", "upMrktS");
        }
        else {
            $('#dvmonthTotal').attr("style", "color: red;");
            //$('#dvmonthlyprofit').attr("class", "downMrktS");

        }
         $('#dvholiday').html(jsonObj[0].holiday);
         $('#dvdividend').text('Dividend for [' + name + '- ' + d.getFullYear() + ']-> ₹' + (jsonObj[0].dividend).toLocaleString('en-IN')+'/-');

        var dNow = new Date();
       
        var dateTime = (dNow.getDate()) + '/' + dNow.getMonth() + '/' + dNow.getFullYear() + ' ' + formatAMPM(dNow);
      
        $('#datetimev').html('Last Updated on :' + '<span style="font-weight: bold;">' + dateTime + '</span>');

    }
