            Script_code: $('#txtStock').val(),
            DateAdded: $('#txtStockDate').val(),
            shares: $('#txtShares').val(),
            inv_Price: $('#txtPrice').val()
        };
        
        var inputval=(JSON.stringify(jsonInput1));
     //   alert(inputval);   
        $.ajax({
