// Structure of the strategies table on the last rebuild. The 8s poll re-runs
// GettodaysOrder every cycle; rebuilding the DataTable each time flashes the
// grid and collapses expanded rows. We only rebuild when the strategy/leg
// structure actually changed — otherwise we leave the table alone and just
// refresh the live P/L numbers in place (a silent update).
var _ordersSignature = null;

function GettodaysOrder(orders) {

    var signature = JSON.stringify(orders || []);

    if (signature === _ordersSignature && $.fn.DataTable.isDataTable('#ordersTable')) {
        // Nothing structural changed — just update LTP / P/L silently, no rebuild.
        refreshAllStrategyLtps();
        return;
    }

    _ordersSignature = signature;

    var table = $('#ordersTable').DataTable({

        destroy: true,

        paging: false,

        searching: false,

        ordering: false,

        info: false,

        autoWidth: false,

        data: orders,

        columns: [

            {
                className: 'details-control',
                orderable: false,
                data: null,
                defaultContent: '<button class="btn btn-sm btn-primary">+</button>',
                width: "40px"
            },

            {
                data: 'StrategyName'
            },

            {
                data: 'Symbol'
            },

            {
                data: 'Legs',
                render: function (legs) {

                    if (!legs || !legs.length) return '-';

                    var rows = $.map(legs, function (leg) {

                        var expiryText = '-';
                        if (leg.ExpiryDate) {
                            var dt = new Date(leg.ExpiryDate);
                            if (!isNaN(dt.getTime()) && dt.getFullYear() >= 1970) {
                                var mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                                var dd = ('0' + dt.getDate()).slice(-2);
                                var mm = mNames[dt.getMonth()];
                                var yy = ('0' + (dt.getFullYear() % 100)).slice(-2);
                                expiryText = dd + '-' + mm + '-' + yy;
                            }
                        }

                        var strikeText = (leg.StrikePrice == null ? '-' : leg.StrikePrice);

                        var instr = (leg.InstrumentType || '').toUpperCase();
                        var act   = (leg.ActionType   || '').toUpperCase();
                        var actShort =
                            act === 'BUY'  ? 'B' :
                            act === 'SELL' ? 'S' : act.charAt(0);
                        var actColor = act === 'BUY' ? 'green' : (act === 'SELL' ? 'red' : 'inherit');

                        var strikeCell = strikeText +
                            (instr ? ' (' + instr + ')' : '') +
                            (actShort ? '<span style="color:' + actColor + '">(' + actShort + ')</span>' : '');

                        var entry = leg.TradePrice != null ? leg.TradePrice : 0;
                        var qty   = leg.Quantity != null ? leg.Quantity : 0;

                        return '<tr>' +
                            '<td style="padding:2px 8px;border:0;">' + expiryText + '</td>' +
                            '<td style="padding:2px 8px;border:0;">' + strikeCell + '</td>' +
                            '<td style="padding:2px 8px;border:0;"><span class="leg-pl-inline" data-legid="' + leg.LegId + '" data-entry="' + entry + '" data-qty="' + qty + '">-</span></td>' +
                            '</tr>';

                    }).join('');

                    return '<table style="font:bold 16px Arial;border:0;margin:0;">' + rows + '</table>';
                }
            },

            {
                data: 'TotalPremium',
                render: function (data) {

                    return '<span style="font-weight:bold;color:green;">₹ ' + data + '</span>';
                }
            },

            {
                data: null,
                render: function (data) {

                    return '<span class="strategy-pl" data-strategyid="' + data.StrategyId + '" style="font-weight:bold;">-</span>';
                }
            },

            {
                data: null,
                render: function (data) {

                   return `
    <button  class="btn btn-warning btn-sm view" data-id="${data.StrategyId}" data-name="${data.StrategyName}">
        <i class="fa fa-edit"></i> View
    </button>

    <button  style="display:none" class="btn btn-danger btn-sm delete" data-id="${data.StrategyId}">
        <i class="fa fa-trash"></i> Delete
    </button>
`;
                }
            }

        ]
    });



