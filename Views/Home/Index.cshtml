    function  MoodDesc(val)
    {
      //  alert(val);
        $('#l30').hide();
        $('#l3050').hide();
        $('#l5070').hide();
        $('#lg70').hide();

        if (val <= 30) {
            $('#l30').show();
            $('#val1').text(val);
        }
        if (val > 30 && val <= 50) {
            $('#l3050').show();
            $('#val2').text(val);
        }

        if (val > 50 && val <= 70) {
            $('#l5070').show();
            $('#val3').text(val);
        }
        if (val > 70) {
            $('#lg70').show();
            $('#val4').text(val);
        }

       

    }
    function addZero(i) {
        if (i < 10) { i = "0" + i }
        return i;
    }
   
    function formatAMPM(date) {
        var hours = date.getHours();
        var minutes = date.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var seconds = addZero(date.getSeconds());
        var strTime = hours + ':' + minutes + ':' + seconds +' '+ ampm;
        return strTime;
    }

