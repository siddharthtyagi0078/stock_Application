    var expandedStrategyIds = new Set();

    function refreshLegLtps(strategyId) {
        $.getJSON('/OptionChain/GetLegLtps?strategyId=' + strategyId, function (resp) {
            if (!resp) return;
            if (resp.error) console.warn('GetLegLtps error for strategy ' + strategyId + ':', resp.error);
            if (!resp.legs) return;

            var totalPl = null;

            $.each(resp.legs, function (i, leg) {
                // Json() camelCases keys (legId/ltp/pl); tolerate PascalCase too.
                var legId = leg.legId != null ? leg.legId : leg.LegId;
                var ltp = leg.ltp !== undefined ? leg.ltp : leg.LTP;
                var pl = leg.pl !== undefined ? leg.pl : leg.PL;

                if (pl != null) {
                    totalPl = (totalPl == null ? 0 : totalPl) + Number(pl);
                }

                // Inline per-leg P/L spans live in the parent strategy row and always exist.
                var inlinePlCell = $('.leg-pl-inline[data-legid="' + legId + '"]');
                if (pl == null) {
                    inlinePlCell.text('-').css('color', '');
                } else {
                    var inlinePlNum = Number(pl);
                    var entry = Number(inlinePlCell.data('entry')) || 0;
                    var qty   = Number(inlinePlCell.data('qty'))   || 0;
                    var basis = entry * qty;
                    var pctText = '';
                    if (basis > 0) {
                        var pct = (inlinePlNum / basis) * 100;
                        pctText = ' (' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%)';
                    }
                    inlinePlCell.text(inlinePlNum.toFixed(2) + pctText).css('color', inlinePlNum >= 0 ? 'green' : 'red');
                }

                // Leg cells exist only while the strategy row is expanded.
                var ltpCell = $('.leg-ltp[data-legid="' + legId + '"]');
                var plCell = $('.leg-pl[data-legid="' + legId + '"]');
                if (ltpCell.length === 0) return;

                ltpCell.text(ltp == null ? '-' : Number(ltp).toFixed(2));

                if (pl == null) {
                    plCell.text('-').css('color', '');
                } else {
                    var plNum = Number(pl);
                    plCell.text(plNum.toFixed(2)).css('color', plNum >= 0 ? 'green' : 'red');
                }
            });

            var totalCell = $('.strategy-pl[data-strategyid="' + strategyId + '"]');

            if (totalCell.length) {
                if (totalPl == null) {
                    totalCell.text('-').css('color', '');
                } else {
                    totalCell.text('₹ ' + totalPl.toFixed(2)).css('color', totalPl >= 0 ? 'green' : 'red');
                }
            }
        });
    }

    function refreshAllStrategyLtps() {
        var tbl = $('#ordersTable').DataTable();
        tbl.rows().every(function () {
            var d = this.data();
            if (d && d.StrategyId) refreshLegLtps(d.StrategyId);
        });
    }

    function reloadt()
   {

        $('#tblprofitstockt').DataTable().ajax.reload();
        $("#tblstock").DataTable().ajax.reload();
        loadNiftyEma();

    }

    // Latest snapshot of rendered rows, used by the Export button.
    var niftyEmaRows = [];

    // Pull NIFTY 1-min candles for the full trading day (09:15 - 15:30),
    // render EMA10/EMA30 and crossover trend. Table body scrolls; latest row is
    // scrolled into view and highlighted so you can spot the newest crossover fast.
    function loadNiftyEma() {
        $.getJSON('/Home/GetNiftyEma?rows=20', function (resp) {

            var $body = $('#niftyEmaBody');

            if (!resp || !resp.ok) {
                $body.html('<tr><td colspan="6" style="text-align:center;color:#c00;">' +
                    ((resp && resp.error) ? String(resp.error).replace(/</g, '&lt;') : 'Fetch failed') +
                    '</td></tr>');
                $('#niftyEmaStatus').text('');
                return;
            }

            var rows = resp.rows || [];
            niftyEmaRows = rows;
            if (!rows.length) {
                $body.html('<tr><td colspan="6" style="text-align:center;color:#888;">No candles yet for today.</td></tr>');
                $('#niftyEmaStatus').text('');
                return;
            }

            var html = '';
            var crossCount = 0;
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                if (r.cross) crossCount++;

                // Base tint from the bias (every row is either Sell PE, Sell CE, or —)
                var trendColor =
                    r.trend === 'SELL PE(Bullish)' ? '#0a7d1a' :
                    r.trend === 'SELL CE(Bearish)' ? '#c02020' : '#666';
                var rowBg =
                    r.trend === 'SELL PE(Bullish)' ? '#f2fbf3' :
                    r.trend === 'SELL CE(Bearish)' ? '#fdf3f3' : '';

                // Crossover bar — the exact minute the bias flipped — gets a stronger fill + border.
                if (r.cross) {
                    rowBg = r.trend === 'SELL PE(Bullish)' ? '#c8ecc8' : '#f7cccc';
                }

                var isLast = (i === rows.length - 1);
                if (isLast && !r.cross) {
                    rowBg = '#fff8dc';    // gentle highlight for the newest candle when it isn't itself a cross
                }
                var extraCell = r.cross
                    ? ' <span style="font-size:11px;background:' + (r.trend === 'SELL PE(Bullish)' ? '#0a7d1a' : '#c02020') +
                        ';color:#fff;padding:1px 6px;border-radius:8px;margin-left:6px;">CROSS</span>'
                    : '';

                var diff = Number(r.ema10) - Number(r.ema30);
                var diffColor = diff > 0 ? '#0a7d1a' : (diff < 0 ? '#c02020' : '#666');
                var diffText = (diff >= 0 ? '+' : '') + diff.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                html += '<tr id="' + (isLast ? 'niftyEmaLastRow' : ('niftyEmaRow' + i)) + '" ' +
                        'style="background:' + rowBg + ';">' +
                    '<td>' + r.candle + '</td>' +
                    '<td style="text-align:right;">' + Number(r.close).toLocaleString('en-IN') + '</td>' +
                    '<td style="text-align:right;">' + Number(r.ema10).toLocaleString('en-IN') + '</td>' +
                    '<td style="text-align:right;">' + Number(r.ema30).toLocaleString('en-IN') + '</td>' +
                    '<td style="color:' + trendColor + ';font-weight:bold;">' + r.trend + extraCell + '</td>' +
                    '<td style="text-align:right;color:' + diffColor + ';font-weight:bold;">' + diffText + '</td>' +
                    '</tr>';
            }
            $body.html(html);

            var last = rows[rows.length - 1];
            $('#niftyEmaStatus').text(rows.length + ' candles · last ' + last.candle + ' · ' + crossCount + ' crossover' + (crossCount === 1 ? '' : 's'));

        }).fail(function () {
            $('#niftyEmaBody').html('<tr><td colspan="6" style="text-align:center;color:#c00;">Fetch failed</td></tr>');
        });
    }

    // Build a CSV of the currently-loaded NIFTY EMA table and trigger a download.
    // CSV opens directly in Excel; the UTF-8 BOM keeps ₹ / accents intact.
    function exportNiftyEmaToExcel() {
        if (!niftyEmaRows || !niftyEmaRows.length) {
            alert('No candles loaded yet.');
            return;
        }

        var header = ['Candle', 'Close', 'EMA10', 'EMA30', 'Trend', 'EMA10-EMA30', 'Crossover'];

        function csvCell(v) {
            var s = (v === null || v === undefined) ? '' : String(v);
            if (/[",\r\n]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
            return s;
        }

        var lines = [header.map(csvCell).join(',')];
        for (var i = 0; i < niftyEmaRows.length; i++) {
            var r = niftyEmaRows[i];
            lines.push([
                r.candle,
                r.close,
                r.ema10,
                r.ema30,
                r.trend,
                (Number(r.ema10) - Number(r.ema30)).toFixed(2),
                r.cross ? 'YES' : ''
            ].map(csvCell).join(','));
        }

        var csv = '﻿' + lines.join('\r\n');    // BOM for Excel
        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });

        var d = new Date();
        var fname = 'NIFTY_EMA_' +
            d.getFullYear() +
            ('0' + (d.getMonth() + 1)).slice(-2) +
            ('0' + d.getDate()).slice(-2) + '_' +
            ('0' + d.getHours()).slice(-2) +
            ('0' + d.getMinutes()).slice(-2) + '.csv';

        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = fname;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () {
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }, 0);
    }

    $(document).on('click', '#niftyEmaExport', exportNiftyEmaToExcel);

