    $('#ordersTable tbody').off('click', 'td.details-control');

    $('#ordersTable tbody').on('click', 'td.details-control', function () {

        var tr = $(this).closest('tr');

        var row = table.row(tr);

        var btn = $(this).find("button");

        var strategyId = row.data().StrategyId;

        if (row.child.isShown()) {

            row.child.hide();

            tr.removeClass('shown');

            btn.text("+");

            expandedStrategyIds.delete(strategyId);
        }
        else {

            row.child(formatChildTable(row.data().Legs)).show();

            tr.addClass('shown');

            btn.text("-");

            expandedStrategyIds.add(strategyId);

            refreshLegLtps(strategyId);
        }

    });

    // Re-open any strategy rows that were expanded before the table was rebuilt,
    // so an 8s ajax.reload() doesn't visually collapse the panel.
    table.rows().every(function () {
        var d = this.data();
        if (d && expandedStrategyIds.has(d.StrategyId)) {
            this.child(formatChildTable(d.Legs)).show();
            $(this.node()).addClass('shown');
            $(this.node()).find('td.details-control button').text('-');
        }
    });

    // Refresh LTP / per-leg P/L / total P/L for every strategy (runs on each 8s rebuild too).
    refreshAllStrategyLtps();



