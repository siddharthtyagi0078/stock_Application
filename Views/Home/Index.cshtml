    // Render the AI comment's markdown (**bold**, * bullets) as readable HTML.
    // Maximum Loss / Profitable Range lines get a highlighted, larger, bolder callout.
    function formatRemarksHtml(text) {

        // escape any HTML first, then apply markdown replacements
        var html = $('<div>').text(text).html();

        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        html = html.replace(/^\s*\*\s+/gm, '&bull; ');

        // Highlight the last two summary lines (Maximum Loss + Profitable Range)
        var highlightStyle =
            'display:block;background:#d4edda;color:#155724;' +
            'font-size:1.2em;font-weight:800;padding:10px 14px;' +
            'border-radius:6px;margin:12px 0;line-height:1.5;';

        // The AI sometimes emits "**Maximum Loss:**" (colon inside the bold) and
        // sometimes "**Maximum Loss**:" (colon outside), so allow an optional colon
        // either way — otherwise the highlight only fires for one of the variants.
        html = html.replace(
            /(<strong>\s*Maximum Loss\s*:?\s*<\/strong>[^\n]*)/,
            '<span style="' + highlightStyle + '">$1</span>'
        );
        html = html.replace(
            /(<strong>\s*Profitable Range\s*:?\s*<\/strong>[^\n]*)/,
            '<span style="' + highlightStyle + '">$1</span>'
        );

        html = html.replace(/\n/g, '<br>');

        return html;
    }

