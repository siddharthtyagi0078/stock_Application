                { "data": "Script_name", "autoWidth": true },

                { "data": "Date_added", "autoWidth": true },
                { "data": "current_Price_str", "autoWidth": true },


                { "data": "tgt_date", "autoWidth": true },
                { "data": "notes", "autoWidth": true },
                         { "data": "tgt_achieve_date", "autoWidth": true },
                {
                    "data": "id",
                    "render": function (data, type, row, meta) {
                        data = '<a href="#" onclick="return removeid(' + data + ');"> <img src="/images/delete.png" style="height:50px;" /></a>';
                        return data;
                    }
