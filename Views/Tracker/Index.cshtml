<script>
    const month = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    setTimeout($("#btnRefresh").click, 180);

    $(document).ready(function () {
        $(".tab-nav-wrapper li.active").click();
        $($(".tab-nav-wrapper li.active a").attr("href")).show();

        $(".tab-nav-wrapper li").click(function (e) {
            e.preventDefault();
            e.stopPropagation();

            $(".tab-nav-wrapper li").removeClass("active");
            $(this).addClass("active");

            var target = $(this).find("a").attr("href");
            $(".tab-content-wrapper").find(".tab-content").hide();
            $(".tab-content-wrapper").find(target).show();

           
        })
    });
    
    $(document).ready(function () {
     
        var d = new Date();
        var month = d.getMonth() + 1;
        var day = d.getDate();

        var output =  (month < 10 ? '0' : '') + month + '/' +
        (day < 10 ? '0' : '') + day + '/' +
           
            d.getFullYear();
        $("#txtStockDate").datepicker();
        $("#txtStockDate").val(output);
        $("#txtStockDatet").datepicker();
        $("#txtStockDatet").val(output);
        showtracking();
    });

    $("#txtStockt").autocomplete({
        source: function (request, response) {
            $.ajax({
                url: "/Reports/Index",
                type: "POST",
                dataType: "json",
                data: { Prefix: request.term },
                success: function (data) {
                    response($.map(data, function (item) {
                        return { label: item.name, value: item.code };
                    }))
                }
            })
        },
        messages: {
            noResults: "", results: ""
        }
    });

    function showmsg(result) {
        alert(result);
    }

    function formatAMPM(date) {
        var hours = date.getHours();
        var minutes = date.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var strTime = hours + ':' + minutes + ' ' + ampm;
        return strTime;
    }

    function setstyle(spanid, val) {

        if (val > 0) {
            $('#' + spanid).attr("style", "color: green");
            $('#' + spanid + 'a').attr("class", "upMrktS");
        }
        else {
            $('#' + spanid + 'a').attr("style", "color: red");
            $('#' + spanid + 'a').attr("class", "downMrktS");

        }
    }

   

    function ShowStock() {


        $("#dvprofit").toggle();
        $("#tblprofitstock").DataTable({
            "processing": true,
            "destroy": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "paging": false,
            "ajax":
            {
                "url": "/Home/GetprofitStockDetails",
                "type": "POST",
                "dataType": "JSON",
                "dataSrc": function (json) {
                    debugger;
                    jsonObj = $.parseJSON(json.data)
                    //alert(json.data);
                    CalculateprofitData(jsonObj);
                    return jsonObj;
                }
            },

            "columns": [
                { "data": "Sno", "autoWidth": false },
                { "data": "Name", "autoWidth": true },
                {
                    data: 'profitpercent', "autoWidth": true,
                    render: function (data, type) {
                        if (data <= 0) {
                            color = 'red';
                            Class = 'downMrktS';
                        }
                        else if (data > 0) {
                            color = 'Green';
                            Class = 'upMrktS';
                        }
                        return `<span style="color:${color};font-weight: bold;" >${data.toLocaleString('en-IN').toLocaleString('en-IN')}%</span><span class=${Class}></span>`;

                    }
                },

                { "data": "buyPrice", "autoWidth": true },
                { "data": "SellPrice", "autoWidth": true },
                {
                    data: 'perShare', "autoWidth": true,
                    render: function (data, type) {
                        if (data <= 0) {
                            color = 'red';
                            Class = 'downMrktS';
                        }
                        else if (data > 0) {
                            color = 'Green';
                            Class = 'upMrktS';
                        }
                        return `<span style="color:${color};font-weight: bold;" >₹${data.toLocaleString('en-IN').toLocaleString('en-IN')}</span><span class=${Class}></span>`;

                    }
                },
                {
                    data: 'netProfit', "autoWidth": true,
                    render: function (data, type) {
                        if (data <= 0) {
                            color = 'red';
                            Class = 'downMrktS';
                        }
                        else if (data > 0) {
                            color = 'Green';
                            Class = 'upMrktS';
                        }
                        return `<span style="color:${color};font-weight: bold;" >₹${data.toLocaleString('en-IN').toLocaleString('en-IN')}</span><span class=${Class}></span>`;

                    }
                },
                { "data": "SoldOn", "autoWidth": true },
            ]

        });

        var table = $('#tblprofitstock').DataTable();

    }




    function AddStockt() {
        debugger;
        if ($('#txtStockt').val() == '') {
            alert('Please enter stock');
            $('#txtStockt').focus();
            return false;
        }
        
        if ($('#txtPricet').val() == '') {
            alert('Please enter price');
            $('#txtPricet').focus();
            return false;
        }

        if ($('#txtStockDatet').val() == '') {
            alert('Please enter stock date');
            $('#txtStockDatet').focus();
            return false;
        }
        //if ($('#txtShares').val() == '') {
        //    alert('Please enter shares');
        //    $('#txtShares').focus();
        //    return false;
        //}
       // alert($('#txtStockDatet').val());

        var jsonInput1 = {
            Script_code: $('#txtStockt').val(),
            tgt_Date: $('#txtStockDatet').val(),
            notes: $('#txtnotes').val(),
            tgt_Price: $('#txtPricet').val()
        };

        var inputval = (JSON.stringify(jsonInput1));
        //   alert(inputval);
        $.ajax({
            type: 'POST',
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            url: '/Tracker/AddTrack/?jsonInput=' + inputval,
            //  data:  inputval ,
            data: ({ jsonInput: JSON.stringify(jsonInput1) }),
            success: function (result) {
                //  loadData();
                debugger;
              //  showmsg(result)
             //   alert(result);
            },
            error: function (errormessage) {
                debugger;
                alert('error');
            }
        });

        alert("Stock Added");
        showtracking();
    }

    function showtracking() {

      //  $("#dvprofit").toggle();
        $("#tblprofitstockt").DataTable({
            "processing": true,
            "destroy": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "paging": false,
            "ajax":
            {
                "url": "/Home/GetStockTrackingDetails?val=3",
                "type": "POST",
                "dataType": "JSON",
                "dataSrc": function (json) {
                    debugger;
                    jsonObj = $.parseJSON(json.data)
