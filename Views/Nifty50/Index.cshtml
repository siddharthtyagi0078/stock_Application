<script>
    
    $(document).ready(function () {
        showtracking();
    });

    function showtracking() {
      
      //  $("#dvprofit").toggle();
        $("#tblnifty50").DataTable({
            "processing": true,
            "destroy": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "paging": false,
            "ajax":
            {
                "url": "/Nifty50/GetNifty50",
                "type": "POST",
                "dataType": "JSON",
                "dataSrc": function (json) {
                    debugger;
                  //  alert("1");
                    jsonObj = $.parseJSON(json.data)
                    return jsonObj;
                }
            },

            "columns": [
                { "data": "Sno", "autoWidth": false },
                { "data": "Company_Name", "autoWidth": true },
                { "data": "stockModel.close", "autoWidth": true, "style": "background:blue;" },
                { "data": "Industry", "autoWidth": true },
                { "data": "Weight", "autoWidth": true }
            ]

        });

        var table = $('#tblnifty50').DataTable();

    }


</script>
